NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_EMAIL=admin@crm.com
NEXT_PUBLIC_DEMO_PASSWORD=123456

# Google Calendar
GOOGLE_CALENDAR_CLIENT_ID=your-client-id
GOOGLE_CALENDAR_CLIENT_SECRET=your-client-secret
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/auth/callback/google-calendar
GOOGLE_CALENDAR_ACCESS_TOKEN=your-access-token

# WhatsApp
WHATSAPP_API_URL=https://graph.facebook.com/v18.0
WHATSAPP_API_TOKEN=your-whatsapp-api-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# Storage
STORAGE_PROVIDER=supabase
STORAGE_BUCKET=crm-files
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY=your-access-key
STORAGE_SECRET_KEY=your-secret-key
STORAGE_ENDPOINT=https://your-project.supabase.co/storage/v1/s3

# Webhooks
WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_BASE_URL=http://localhost:3000

# External APIs
EXTERNAL_API_BASE_URL=https://api.exemplo.com
EXTERNAL_API_KEY=your-external-api-key
EXTERNAL_API_TIMEOUT_MS=15000
